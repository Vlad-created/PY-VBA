CustWatch Month2 = 
VAR MonthList = VALUES('006 Select TV_Watched'[Order Create Month])
VAR SortedMonths = 
    ADDCOLUMNS(
        MonthList, 
        "MonthRank", RANKX(MonthList, [Order Create Month], ASC)
    )
VAR SecondMonth = 
    MINX(
        FILTER(SortedMonths, [MonthRank] = 2), 
        '006 Select TV_Watched'[Order Create Month]
    )
VAR 