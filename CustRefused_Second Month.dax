CustRefused_Month2 = 
VAR MonthList = VALUES('All Regions'[Order_Create_Month])
VAR SortedMonths = 
    ADDCOLUMNS(
        MonthList,
        "MonthRank", RANKX(MonthList, 'All Regions'[Order_Create_Month], , ASC)
    )

VAR SecondMonth = 
    MINX(
        FILTER(SortedMonths, [MonthRank] = 2),
        'All Regions'[Order_Create_Month]
    )

VAR RefusedFilter = 
    FILTER(
        'All Regions',
        'All Regions'[Ticket_close_reason_mapping] = "Refused" &&
        'All Regions'[Order_Create_Month] = SecondMonth
    )

VAR custRefusedSUM = CALCULATE(SUM('All Regions'[custRefused]), RefusedFilter)
VAR RefusedSUM = CALCULATE(SUM('All Regions'[Refused]), RefusedFilter)

RETURN DIVIDE(custRefusedSUM, RefusedSUM, 0)

